# Copy to .env locally. Never commit the real file.
# On GitHub Actions these names are repository secrets, not a file.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional. Empty = public Live Shows iCal (Asia/Qatar).
CUECAST_ICAL=

CUECAST_PRIVACY=unlisted
CUECAST_DRY_RUN=0
